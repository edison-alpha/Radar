{
  "name": "token-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "data": "node scripts/prepare-data.mjs",
    "logos:fetch": "node scripts/fetch-protocol-logos.mjs",
    "history:fetch": "node scripts/fetch-tvl-history.mjs",
    "chains:fetch": "node scripts/fetch-chain-logos.mjs",
    "build": "node scripts/prepare.mjs && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:render": "node scripts/test-render.mjs",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write src lib scripts tests main.ts vite.config.js"
  },
  "dependencies": {
    "@fontsource-variable/funnel-sans": "^5.3.0",
    "@iconify/react": "^6.0.4",
    "@tanstack/react-table": "^8.21.3",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/streamline-flex": "^1.2.3",
    "@iconify/utils": "^3.1.7",
    "esbuild": "^0.25.12",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "sharp": "^0.34.5",
    "vite": "^7.2.2"
  }
}
